{
  "schemaVersion": 1,
  "exclude": ["node_modules", "dist", "build", "coverage", ".git", "tests/fixtures"],
  "diagnosticSkipRoots": ["harness", "scripts"],
  "maxFiles": 5000,
  "maxFileLines": 800,
  "fanOutThreshold": 8,
  "fanInThreshold": 8,
  "churnDays": 90,
  "baselineDir": ".r3-doctor/baselines",
  "trendDir": ".r3-doctor/trends",
  "policyFile": ".r3-doctor/policy.json",
  "units": [
    { "id": "core", "roots": ["src/evidence", "src/assessment"] },
    { "id": "cli", "roots": ["src/commands"] }
  ]
}

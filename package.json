{
  "name": "r3-doctor",
  "version": "0.1.1",
  "description": "Regression Risk Recovery Doctor — diagnostic CLI for regression risk",
  "type": "module",
  "license": "MIT",
  "author": "kaz-toc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaz-toc/r3-doctor.git"
  },
  "homepage": "https://github.com/kaz-toc/r3-doctor#readme",
  "bugs": {
    "url": "https://github.com/kaz-toc/r3-doctor/issues"
  },
  "keywords": [
    "regression",
    "risk",
    "recovery",
    "diagnostics",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "r3-doctor": "./dist/cli.js"
  },
  "files": [
    "dist",
    "tests/fixtures",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "node scripts/setup-product.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
    "r3-doctor": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "harness:test": "node --test harness/__tests__/*.test.mjs",
    "harness:validate": "node harness/run-checks.mjs validate",
    "harness:report": "node harness/run-checks.mjs report",
    "smoke:llm-integration": "node scripts/smoke-llm-integration.mjs",
    "validate": "npm run harness:test && npm run harness:validate && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@clack/prompts": "^0.10.1",
    "commander": "^14.0.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "vitest": "^3.2.6"
  }
}
